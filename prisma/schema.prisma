generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int                @id @default(autoincrement())
  email         String             @unique
  password      String
  name          String
  birth_date    DateTime
  gender        Genders            @relation(fields: [gender_id], references: [id], onDelete: Cascade)
  gender_id     Int
  city          Cities             @relation(fields: [city_id], references: [id], onDelete: Cascade)
  city_id       Int
  creation_date DateTime           @default(now())
  likes_count   Int                @default(0)
  image_path    String
  canTeach      UserCanTeach[]
  wantsToLearn  UserWantsToLearn[]
  refreshToken  String?
}

model UserCanTeach {
  title       String
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id     Int
  subskill    Subskills @relation(fields: [subskill_id], references: [id], onDelete: Cascade)
  subskill_id Int

  @@id([user_id, subskill_id])
}

model UserWantsToLearn {
  title       String
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id     Int
  subskill    Subskills @relation(fields: [subskill_id], references: [id], onDelete: Cascade)
  subskill_id Int

  @@id([user_id, subskill_id])
}

model Cities {
  id    Int    @id @default(autoincrement())
  title String
  users User[]
}

model Genders {
  id    Int    @id @default(autoincrement())
  title String
  users User[]
}

model Subskills {
  id                Int                @id @default(autoincrement())
  title             String
  skill             Skills             @relation(fields: [skill_id], references: [id], onDelete: Cascade)
  skill_id          Int
  canTeachUsers     UserCanTeach[]
  wantsToLearnUsers UserWantsToLearn[]
}

model Skills {
  id        Int         @id @default(autoincrement())
  title     String
  subskills Subskills[]
  icon_src  String
  color     String
}
